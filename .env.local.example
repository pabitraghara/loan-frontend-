# Base URL of the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Jornaya LeadiD account campaign id (required for TCPA consent certification)
NEXT_PUBLIC_JORNAYA_CAMPAIGN_ID=

# TrustedForm - set to false to disable the script in local development
NEXT_PUBLIC_TRUSTEDFORM_ENABLED=true

NEXT_PUBLIC_BRAND_NAME=New Loans
NEXT_PUBLIC_SUPPORT_PHONE=(800) 555-0143
